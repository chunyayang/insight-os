strict-peer-dependencies=false
shamefully-hoist=false

# pnpm >=11's install pipeline enforces a default minimumReleaseAge supply-chain
# check: packages published very recently (currently ~24h) fail lockfile
# verification with ERR_PNPM_MINIMUM_RELEASE_AGE_VIOLATION. This is expected —
# not a broken lockfile or a real CI bug. It self-resolves once the flagged
# packages age past the cutoff; re-run CI rather than investigating from
# scratch. See TODO.md "Decisions & deviations" for the incident this was
# first seen on (dependabot PR #13, 2026-07-25).
