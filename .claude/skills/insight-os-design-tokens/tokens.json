{
  "$meta": {
    "name": "Insight OS Design Tokens",
    "description": "Design tokens for the Insight OS analytics SaaS prototype. Values are given per theme (light, dark). Tokens map 1:1 to CSS custom properties of the same name (prefixed with --).",
    "themes": ["light", "dark"],
    "themeSelector": { "light": ":root", "dark": ".dark, body.dark" },
    "basePreset": "PrimeVue Aura — primary: emerald, surface: slate",
    "$howToConsume": [
      "The `light`/`dark` hex values are the RESOLVED, authoritative values — use them as-is. Aura's slate+emerald primitives are already baked in.",
      "The `aura` field on each token is PROVENANCE ONLY: it names the Aura primitive/step the value came from (e.g. primary.500, surface.200). Use it to regenerate a token if the Aura preset or primary palette changes — do NOT re-resolve it yourself at build time.",
      "`-ink` and `-soft` are DERIVED ROLE tokens, not Aura primitives. `-ink` = accessible text/icon on the matching `-soft` fill (an Aura .700-ish step); `-soft` = the tinted chip background (an Aura .50 step in light, a low-alpha primary in dark). Reproduce these roles; do not look for an Aura token literally named `*-ink`/`*-soft`.",
      "`aura: \"custom\"` marks a value with no direct Aura step (bespoke). Keep the literal value; do not snap it to the nearest Aura step.",
      "The chart palette is a STANDALONE categorical scale, independent of Aura primitives. Use --chart-0..13 as-is for data series; never remap them to Aura semantic colors."
    ]
  },

  "color": {
    "surface": {
      "$aura": "Aura slate surface ramp; surface.0 = #ffffff. Dark surfaces are a custom navy, not pure Aura slate steps.",
      "bg":     { "var": "--bg",     "light": "#f8fafc", "dark": "#0b1220", "aura": "surface.50 / custom navy (dark)", "use": "app canvas / page background" },
      "card":   { "var": "--card",   "light": "#ffffff", "dark": "#151f31", "aura": "surface.0 / custom navy (dark)", "use": "raised surface, cards, panels" },
      "border": { "var": "--border", "light": "#e2e8f0", "dark": "#28354c", "aura": "surface.200 / custom ~surface.700 (dark)", "use": "hairlines, dividers, control borders" },
      "hover":  { "var": "--hover",  "light": "#f1f5f9", "dark": "#1d2a40", "aura": "surface.100 / custom (dark)", "use": "hover fill, subtle fill" },
      "track":  { "var": "--track",  "light": "#f1f5f9", "dark": "#1d2a40", "aura": "surface.100 / custom (dark)", "use": "progress/slider track, skeleton base" }
    },
    "text": {
      "text":  { "var": "--text",  "light": "#0f172a", "dark": "#f1f5f9", "aura": "surface.900 / surface.100 (dark)", "use": "primary text" },
      "sub":   { "var": "--sub",   "light": "#64748b", "dark": "#94a3b8", "aura": "surface.500 / surface.400 (dark)", "use": "secondary text" },
      "faint": { "var": "--faint", "light": "#94a3b8", "dark": "#5b6b84", "aura": "surface.400 / custom (dark)", "use": "tertiary text, placeholders, axis labels" }
    },
    "semantic": {
      "$aura": "Each family maps to an Aura primitive palette. Base = .500 (light) / .400 (dark). `-ink` = .700 (light) / .300 (dark) role for text on tint. `-soft` = .50 (light) / low-alpha base (dark) tint fill. These are Aura color PRIMITIVES, not Aura's own semantic token names.",
      "prim":        { "var": "--prim",        "light": "#10b981", "dark": "#34d399",              "aura": "emerald (primary) .500 / .400 (dark)", "use": "brand green; primary actions, active/positive, focus ring" },
      "prim-ink":    { "var": "--prim-ink",    "light": "#047857", "dark": "#6ee7b7",              "aura": "emerald .700 / .300 (dark) — derived role", "use": "text/icon on prim-soft" },
      "prim-soft":   { "var": "--prim-soft",   "light": "#ecfdf5", "dark": "rgba(16,185,129,.14)", "aura": "emerald .50 / base @14% (dark) — derived role", "use": "tinted background chip" },
      "danger":      { "var": "--danger",      "light": "#ef4444", "dark": "#f87171",              "aura": "red .500 / .400 (dark)", "use": "destructive, errors, down-trend, critical severity" },
      "danger-ink":  { "var": "--danger-ink",  "light": "#b91c1c", "dark": "#fca5a5",              "aura": "red .700 / .300 (dark) — derived role", "use": "text/icon on danger-soft" },
      "danger-soft": { "var": "--danger-soft", "light": "#fef2f2", "dark": "rgba(239,68,68,.15)",  "aura": "red .50 / base @15% (dark) — derived role", "use": "tinted background chip" },
      "warn":        { "var": "--warn",        "light": "#d97706", "dark": "#fbbf24",              "aura": "amber .600 / .400 (dark) — NOTE: Aura's 'warn' message severity uses amber.500 (#f59e0b)", "use": "warnings, medium severity" },
      "warn-ink":    { "var": "--warn-ink",    "light": "#92400e", "dark": "#fcd34d",              "aura": "amber .800 / .300 (dark) — derived role", "use": "text/icon on warn-soft" },
      "warn-soft":   { "var": "--warn-soft",   "light": "#fffbeb", "dark": "rgba(245,158,11,.15)", "aura": "amber .50 / base @15% (dark) — derived role", "use": "tinted background chip" },
      "info":        { "var": "--info",        "light": "#3b82f6", "dark": "#60a5fa",              "aura": "blue .500 / .400 (dark)", "use": "informational, neutral emphasis, running status" },
      "info-ink":    { "var": "--info-ink",    "light": "#1d4ed8", "dark": "#93c5fd",              "aura": "blue .700 / .300 (dark) — derived role", "use": "text/icon on info-soft" },
      "info-soft":   { "var": "--info-soft",   "light": "#eff6ff", "dark": "rgba(59,130,246,.15)", "aura": "blue .50 / base @15% (dark) — derived role", "use": "tinted background chip" },
      "violet":      { "var": "--violet",      "light": "#8b5cf6", "dark": "#a78bfa",              "aura": "violet .500 / .400 (dark)", "use": "secondary categorical accent" },
      "violet-soft": { "var": "--violet-soft", "light": "#f5f3ff", "dark": "rgba(139,92,246,.16)", "aura": "violet .50 / base @16% (dark) — derived role", "use": "tinted background chip" }
    },
    "chart": {
      "$note": "Categorical ramp for data series. Assign by index, not by meaning. 14 colors, tuned per theme.",
      "$aura": "EXACT 1:1 copy of the PrimeUI Charts default palette — CSS vars --p-chart-color-0..13 (from @primeui/chart-style/themes/default.css). Both light and dark match byte-for-byte. NOT derived from Aura primitive ramps (emerald/slate/etc.); it is a separate categorical scale designed to pair with Aura. Use these values (or the --p-chart-color-N vars) as-is for series; never remap them to Aura semantic colors.",
      "chart-0":  { "var": "--chart-0",  "light": "#5daeea", "dark": "#6bbbed" },
      "chart-1":  { "var": "--chart-1",  "light": "#ffad5a", "dark": "#ffb76d" },
      "chart-2":  { "var": "--chart-2",  "light": "#ffd166", "dark": "#ffdc7a" },
      "chart-3":  { "var": "--chart-3",  "light": "#4ecdc4", "dark": "#61d8cf" },
      "chart-4":  { "var": "--chart-4",  "light": "#7c8cff", "dark": "#909dff" },
      "chart-5":  { "var": "--chart-5",  "light": "#c084fc", "dark": "#cc99fd" },
      "chart-6":  { "var": "--chart-6",  "light": "#ff6fae", "dark": "#ff82ba" },
      "chart-7":  { "var": "--chart-7",  "light": "#9ccc3c", "dark": "#aad64c" },
      "chart-8":  { "var": "--chart-8",  "light": "#ff7a66", "dark": "#ff8b76" },
      "chart-9":  { "var": "--chart-9",  "light": "#36b7d6", "dark": "#4fc7df" },
      "chart-10": { "var": "--chart-10", "light": "#a78bfa", "dark": "#b79dfb" },
      "chart-11": { "var": "--chart-11", "light": "#5ccf9f", "dark": "#6fdaad" },
      "chart-12": { "var": "--chart-12", "light": "#fda4af", "dark": "#fdb1bb" },
      "chart-13": { "var": "--chart-13", "light": "#94a3b8", "dark": "#a8b5c6" }
    }
  },

  "typography": {
    "fontFamily": { "var": "--font-sans", "value": "'Figtree','Noto Sans TC',system-ui,sans-serif" },
    "fonts": [
      { "family": "Figtree", "role": "UI / Latin", "weights": [400, 500, 600, 700, 800] },
      { "family": "Noto Sans TC", "role": "CJK (繁體中文) fallback", "weights": [400, 500, 700] }
    ],
    "icons": { "family": "PrimeIcons", "version": "7.0.0", "classPrefix": "pi pi-" },
    "lineHeight": { "var": "--line-height", "value": 1.5 },
    "headingLetterSpacing": "-.02em",
    "headingWeight": 800,
    "numeric": "font-variant-numeric: tabular-nums"
  },

  "radius": {
    "chip":    { "var": "--radius-chip",    "value": "6px",   "use": "chips, badges, small pills" },
    "control": { "var": "--radius-control", "value": "9px",   "use": "buttons, inputs, selects, menu items (8-10px range)" },
    "tile":    { "var": "--radius-tile",    "value": "10px",  "use": "icon tiles (9-11px range)" },
    "card":    { "var": "--radius-card",    "value": "14px",  "use": "cards, panels, modals (12-16px range)" },
    "pill":    { "var": "--radius-pill",    "value": "9999px","use": "avatars (50%), fully rounded" }
  },

  "elevation": {
    "shadow": {
      "var": "--shadow",
      "light": "0 1px 3px rgba(15,23,42,.06), 0 1px 2px rgba(15,23,42,.04)",
      "dark": "0 1px 3px rgba(0,0,0,.3)",
      "use": "standard raised-surface shadow"
    }
  },

  "focus": {
    "ring": { "var": "--focus-ring", "value": "2px solid var(--prim)" },
    "offset": { "var": "--focus-offset", "value": "2px" }
  },

  "motion": {
    "keyframes": {
      "fadeUp": "from{opacity:0;transform:translateY(8px)} to{opacity:1;transform:none}",
      "sh":     "0%{background-position:200% 0} 100%{background-position:-200% 0}",
      "blink":  "0%,80%,100%{opacity:.25} 40%{opacity:1}",
      "spin":   "to{transform:rotate(360deg)}"
    },
    "reducedMotion": "All animation/transition disabled under @media (prefers-reduced-motion: reduce)"
  }
}
