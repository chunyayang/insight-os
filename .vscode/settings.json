{
  // Prettier owns formatting in this repo (.prettierrc.json + lint-staged
  // `prettier --write` on *.{ts,vue}); ESLint stays on correctness only.
  // Pinned per-language so Vue - Official (Volar) doesn't compete for .vue.
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "[vue]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  // Tailwind v4 CSS-first at-rules (@plugin, @theme, @utility, …) aren't
  // known to VS Code's built-in CSS language service; silence the false
  // "Unknown at rule" warning instead of suppressing all CSS validation.
  "css.customData": [".vscode/tailwind.css-data.json"],
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  // Use the repo's pinned Prettier, not the extension's bundled copy.
  "prettier.prettierPath": "./node_modules/prettier",
  // ESLint autofix on save complements (never overrides) Prettier.
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "eslint.useFlatConfig": true,
  // Workspace TypeScript 6 over the editor's bundled version.
  // `typescript.tsdk` is the deprecated spelling; this is the current one.
  "js/ts.tsdk.path": "node_modules/typescript/lib"
}
